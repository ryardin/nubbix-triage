# Copiá este archivo como .env y completá tus claves.
# El archivo .env NUNCA se sube al repositorio (está en .gitignore).

# Google Gemini (nivel gratuito) — https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Groq (nivel gratuito) — https://console.groq.com/keys
GROQ_API_KEY=

# Anthropic (opcional, pago) — https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Proveedor por defecto: gemini | groq | anthropic
DEFAULT_PROVIDER=gemini
